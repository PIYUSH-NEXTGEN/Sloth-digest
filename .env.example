# SlothDigest configuration (copy to .env and adjust; defaults are local-only)
# Nothing here leaves your machine. Optional integrations stay disabled until
# you fill in a key; see docs/privacy.md (Agent B) when they are.

# Ollama model tag - run `ollama list` and pick the newest Gemma that fits
SLOTH_MODEL=gemma3:4b
SLOTH_OLLAMA_URL=http://localhost:11434
SLOTH_CONTEXT_TOKENS=16384
# Local embedding model for "Ask your chats" (must be pulled in Ollama)
SLOTH_EMBED_MODEL=nomic-embed-text

# Local storage
SLOTH_DB_PATH=./data/sloth.db
SLOTH_DROP_FOLDER=./data/drop

# Daily digest schedule (local time HH:MM)
SLOTH_DIGEST_TIME=06:00

# Your display names / aliases as they appear in chats (comma separated).
# Drives the "needs you" list. Kept local; never sent anywhere.
SLOTH_USER_NAMES=Your Name,nickname

# OS desktop toast after the scheduled digest (opt-in; local notification only)
SLOTH_DESKTOP_NOTIFY=false

# Optional integrations - empty string means disabled. Keep them off for the
# local-first promise; see AGENTS.md Section 4 rules.
SLOTH_SENTRY_DSN=
SLOTH_ELEVENLABS_API_KEY=
SLOTH_TEMPORAL_ENABLED=false
